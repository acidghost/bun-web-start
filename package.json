{
  "name": "bun-web-start",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch app/server.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run build && ./dist/bun-web-start",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "lit": "3.3.3",
    "missing.css": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
